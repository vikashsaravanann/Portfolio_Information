# Local Development Port
PORT=3000
JSON_BODY_LIMIT_BYTES=65536
CONTACT_BODY_MAX_BYTES=24576
CHAT_BODY_MAX_BYTES=32768

# Grok AI Key for Chatbot (xAI)
XAI_API_KEY=

# Comma-separated CORS allowlist (set to * only if absolutely required)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,https://vikashsaravanann.github.io

# Rate limits
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=8
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20

# Discord webhook URL (Optional)
DISCORD_WEBHOOK_URL=

# Telegram Bot configurations (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP Nodemailer Configurations (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=vikash07052008@gmail.com

# Optional fallback switch
ENABLE_FORMSUBMIT_FALLBACK=true

# --- Broadcast Automation Hub ---
BROADCAST_ADMIN_USERNAME=
BROADCAST_ADMIN_PASSWORD_HASH=
BROADCAST_JWT_SECRET=

# Email (reuse/extend existing SMTP_* vars if suitable, or add a dedicated sender)
BROADCAST_SMTP_HOST=
BROADCAST_SMTP_PORT=
BROADCAST_SMTP_USER=
BROADCAST_SMTP_PASS=

# SMS — Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

# Telegram
TELEGRAM_BROADCAST_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp — official Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Recipient data location
BROADCAST_RECIPIENTS_SOURCE=
